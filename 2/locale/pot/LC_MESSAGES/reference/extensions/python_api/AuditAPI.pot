msgid "Returns"
msgstr ""

#: ../../../conan_sources/conan/api/subapi/audit.py:docstring of
#: conan.api.subapi.audit.AuditAPI.scan:6
msgid ""
"A ``dict`` mapping each scanned reference to its vulnerability information, "
"together with some metadata about the request, with the following shape:  .. "
"code-block:: python      {         \"data\": {             # One entry per "
"scanned reference             \"openssl/3.2.0\": "
"{                 \"vulnerabilities\": {                     \"totalCount\": "
"2,                     # One \"node\" per vulnerability, holding its "
"name,                     # description, severity, cvss, "
"references,                     # advisories, fixed versions, "
"etc.                     \"edges\": [{\"node\": "
"{...}}, ...]                 }             },             # References that "
"could not be scanned carry an error instead             \"unknown/1.0\": "
"{\"error\": {\"details\": \"Package 'unknown/1.0' not scanned: Not found."
"\"}},         },         # URL of the provider that produced the data, or "
"None         \"provider_url\": \"https://...\",         # Only present if "
"the whole request failed (authentication,         # rate limit, server "
"error...). When set, the scan is aborted.         \"conan_error\": \"..."
"\",     }"
msgstr ""

#: ../../../conan_sources/conan/api/subapi/audit.py:docstring of
#: conan.api.subapi.audit.AuditAPI.scan:6
msgid ""
"A ``dict`` mapping each scanned reference to its vulnerability information, "
"together with some metadata about the request, with the following shape:"
msgstr ""

#: ../../../conan_sources/conan/api/subapi/audit.py:docstring of
#: conan.api.subapi.audit.AuditAPI.scan:9
msgid ""
"{\n"
"    \"data\": {\n"
"        # One entry per scanned reference\n"
"        \"openssl/3.2.0\": {\n"
"            \"vulnerabilities\": {\n"
"                \"totalCount\": 2,\n"
"                # One \"node\" per vulnerability, holding its name,\n"
"                # description, severity, cvss, references,\n"
"                # advisories, fixed versions, etc.\n"
"                \"edges\": [{\"node\": {...}}, ...]\n"
"            }\n"
"        },\n"
"        # References that could not be scanned carry an error instead\n"
"        \"unknown/1.0\": {\"error\": {\"details\": \"Package 'unknown/1.0' "
"not scanned: Not found.\"}},\n"
"    },\n"
"    # URL of the provider that produced the data, or None\n"
"    \"provider_url\": \"https://...\",\n"
"    # Only present if the whole request failed (authentication,\n"
"    # rate limit, server error...). When set, the scan is aborted.\n"
"    \"conan_error\": \"...\",\n"
"}"
msgstr ""

