#: ../../../conan_sources/conan/api/subapi/new.py:docstring of
#: conan.api.subapi.new.NewAPI.save_template:1
msgid ""
"Save the ``template`` files in the ``output_folder``, replacing the template "
"variables with the ``defines``"
msgstr ""

#: ../../../conan_sources/conan/api/subapi/new.py:docstring of
#: conan.api.subapi.new.NewAPI.save_template:0
msgid "Parameters"
msgstr ""

#: ../../../conan_sources/conan/api/subapi/new.py:docstring of
#: conan.api.subapi.new.NewAPI.save_template:4
msgid ""
"The template to use: a path to a folder containing the template files "
"(absolute or relative to the current working directory), or the name of a "
"template, either those available under ``<conan_home>/templates/command/new/"
"<template>`` or the built-in ones"
msgstr ""

#: ../../../conan_sources/conan/api/subapi/new.py:docstring of
#: conan.api.subapi.new.NewAPI.save_template:8
msgid "A list with the ``k=v`` variables to replace in the template"
msgstr ""

#: ../../../conan_sources/conan/api/subapi/new.py:docstring of
#: conan.api.subapi.new.NewAPI.save_template:9
msgid "The folder where the template files will be saved, cwd if ``None``"
msgstr ""

#: ../../../conan_sources/conan/api/subapi/new.py:docstring of
#: conan.api.subapi.new.NewAPI.save_template:10
msgid ""
"If ``True``, overwrite the files if they already exist, otherwise raise an "
"error"
msgstr ""
