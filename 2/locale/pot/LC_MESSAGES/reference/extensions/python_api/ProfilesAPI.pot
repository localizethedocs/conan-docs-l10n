#: ../../../reference/extensions/python_api/ProfilesAPI.rst:2
msgid "Profiles API"
msgstr ""

#: ../../../common/experimental_warning.inc:3
msgid ""
"This feature is experimental and subject to breaking changes. See :ref:`the "
"Conan stability<stability>` section for more information."
msgstr ""

#: ../../../common/subapi_instantiation_warning.inc:3
msgid ""
"Subapis **must not** be initialized by themselves. They are intended to be "
"accessed only through the main :ref:`ConanAPI "
"<reference_python_api_conan_api>` attributes."
msgstr ""

#: ../../../conan_sources/conan/api/subapi/profiles.py:docstring of
#: conan.api.subapi.profiles.ProfilesAPI:1
msgid "This ProfilesAPI is used to list, manage and load Conan profiles"
msgstr ""

#: ../../../conan_sources/conan/api/subapi/profiles.py:docstring of
#: conan.api.subapi.profiles.ProfilesAPI.detect:0
#: conan.api.subapi.profiles.ProfilesAPI.get_default_build:0
#: conan.api.subapi.profiles.ProfilesAPI.get_default_host:0
#: conan.api.subapi.profiles.ProfilesAPI.get_path:0
#: conan.api.subapi.profiles.ProfilesAPI.list:0
msgid "Returns"
msgstr ""

#: ../../../conan_sources/conan/api/subapi/profiles.py:docstring of
#: conan.api.subapi.profiles.ProfilesAPI.get_default_host:1
msgid ""
"the path to the default \"host\" profile, either in the cache or as defined "
"by the user in configuration"
msgstr ""

#: ../../../conan_sources/conan/api/subapi/profiles.py:docstring of
#: conan.api.subapi.profiles.ProfilesAPI.get_default_build:1
msgid ""
"the path to the default \"build\" profile, either in the cache or as defined "
"by the user in configuration"
msgstr ""

#: ../../../conan_sources/conan/api/subapi/profiles.py:docstring of
#: conan.api.subapi.profiles.ProfilesAPI.get_profile:1
msgid ""
"Computes a Profile as the result of aggregating all the user arguments, "
"first it loads the \"profiles\", composing them in order (last profile has "
"priority), and finally adding the individual settings, options (priority "
"over the profiles)"
msgstr ""

#: ../../../conan_sources/conan/api/subapi/profiles.py:docstring of
#: conan.api.subapi.profiles.ProfilesAPI.get_profile:0
msgid "Parameters"
msgstr ""

#: ../../../conan_sources/conan/api/subapi/profiles.py:docstring of
#: conan.api.subapi.profiles.ProfilesAPI.get_profile:5
msgid "the list of profiles to load"
msgstr ""

#: ../../../conan_sources/conan/api/subapi/profiles.py:docstring of
#: conan.api.subapi.profiles.ProfilesAPI.get_profile:6
msgid ""
"list of \"key=value\" settings to define the profile. Patterns allowed as "
"\"pkg-pattern:key=value\""
msgstr ""

#: ../../../conan_sources/conan/api/subapi/profiles.py:docstring of
#: conan.api.subapi.profiles.ProfilesAPI.get_profile:8
msgid ""
"list of \"key=value\" options. Patterns allowed as \"pkg-pattern:key=value\""
msgstr ""

#: ../../../conan_sources/conan/api/subapi/profiles.py:docstring of
#: conan.api.subapi.profiles.ProfilesAPI.get_profile:9
msgid ""
"list of \"key=value\" configurations. Following \"conf\" definitions, "
"patterns are allowed as \"pkg-pattern:key=value\", values that are lists or "
"dictionaries might be allowed, and configuration operations like ``+=`` for "
"appending are allowed."
msgstr ""

#: ../../../conan_sources/conan/api/subapi/profiles.py:docstring of
#: conan.api.subapi.profiles.ProfilesAPI.get_profile:12
msgid "the current working directory. If None, os.getcwd() will be used."
msgstr ""

#: ../../../conan_sources/conan/api/subapi/profiles.py:docstring of
#: conan.api.subapi.profiles.ProfilesAPI.get_profile:13
msgid "the context, \"build\" or \"host\" to which this profile belongs"
msgstr ""

#: ../../../conan_sources/conan/api/subapi/profiles.py:docstring of
#: conan.api.subapi.profiles.ProfilesAPI.get_path:1
msgid ""
"the resolved path of the given profile name, that could be in the cache, or "
"local, depending on the \"cwd\""
msgstr ""

#: ../../../conan_sources/conan/api/subapi/profiles.py:docstring of
#: conan.api.subapi.profiles.ProfilesAPI.list:1
msgid "List all the profiles files in the cache"
msgstr ""

#: ../../../conan_sources/conan/api/subapi/profiles.py:docstring of
#: conan.api.subapi.profiles.ProfilesAPI.list:3
msgid ""
"an alphabetically ordered list of profile files in the default cache location"
msgstr ""

#: ../../../conan_sources/conan/api/subapi/profiles.py:docstring of
#: conan.api.subapi.profiles.ProfilesAPI.detect:1
msgid "Detects a possible default profile."
msgstr ""

#: ../../../conan_sources/conan/api/subapi/profiles.py:docstring of
#: conan.api.subapi.profiles.ProfilesAPI.detect:3
msgid ""
"The output of this detection is not guaranteed to be complete or stable, it "
"might change in future releases, following the same rules as the \"conan "
"profile detect\" command."
msgstr ""

#: ../../../conan_sources/conan/api/subapi/profiles.py:docstring of
#: conan.api.subapi.profiles.ProfilesAPI.detect:6
msgid ""
"an automatically detected Profile, with a \"best guess\" of the system "
"settings"
msgstr ""
