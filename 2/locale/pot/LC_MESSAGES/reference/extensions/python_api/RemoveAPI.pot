#: ../../../reference/extensions/python_api/RemoveAPI.rst:2
msgid "Remove API"
msgstr ""

#: ../../../common/experimental_warning.inc:3
msgid ""
"This feature is experimental and subject to breaking changes. See :ref:`the "
"Conan stability<stability>` section for more information."
msgstr ""

#: ../../../common/subapi_instantiation_warning.inc:3
msgid ""
"Subapis **must not** be initialized by themselves. They are intended to be "
"accessed only through the main :ref:`ConanAPI "
"<reference_python_api_conan_api>` attributes."
msgstr ""

#: ../../../conan_sources/conan/api/subapi/remove.py:docstring of
#: conan.api.subapi.remove.RemoveAPI:1
msgid ""
"This API is used to remove artifacts from either remotes or the Conan cache. "
"It can either remove specific package references, or whole recipe references "
"with all its associated packages"
msgstr ""

#: ../../../conan_sources/conan/api/subapi/remove.py:docstring of
#: conan.api.subapi.remove.RemoveAPI.recipe:1
#: conan.api.subapi.remove.RemoveAPI.recipes:1
msgid ""
"Removes the specified recipe reference alongside all its associated packages."
msgstr ""

#: ../../../conan_sources/conan/api/subapi/remove.py:docstring of
#: conan.api.subapi.remove.RemoveAPI.recipe:3
msgid ""
"If ``remote`` is specified, the recipe will be removed from the remote, "
"otherwise they will be removed from the local cache."
msgstr ""

#: ../../../conan_sources/conan/api/subapi/remove.py:docstring of
#: conan.api.subapi.remove.RemoveAPI.package:0
#: conan.api.subapi.remove.RemoveAPI.packages:0
#: conan.api.subapi.remove.RemoveAPI.recipe:0
#: conan.api.subapi.remove.RemoveAPI.recipes:0
msgid "Parameters"
msgstr ""

#: ../../../conan_sources/conan/api/subapi/remove.py:docstring of
#: conan.api.subapi.remove.RemoveAPI.recipe:6
msgid "Recipe reference to remove"
msgstr ""

#: ../../../conan_sources/conan/api/subapi/remove.py:docstring of
#: conan.api.subapi.remove.RemoveAPI.package:7
#: conan.api.subapi.remove.RemoveAPI.packages:12
#: conan.api.subapi.remove.RemoveAPI.recipe:7
#: conan.api.subapi.remove.RemoveAPI.recipes:10
msgid "Optional remote to remove references from"
msgstr ""

#: ../../../conan_sources/conan/api/subapi/remove.py:docstring of
#: conan.api.subapi.remove.RemoveAPI.package:3
#: conan.api.subapi.remove.RemoveAPI.packages:3
#: conan.api.subapi.remove.RemoveAPI.recipes:3
msgid ""
"If ``remote`` is specified, the packages will be removed from the remote, "
"otherwise they will be removed from the local cache."
msgstr ""

#: ../../../conan_sources/conan/api/subapi/remove.py:docstring of
#: conan.api.subapi.remove.RemoveAPI.packages:9
#: conan.api.subapi.remove.RemoveAPI.recipes:7
msgid "Warning:"
msgstr ""

#: ../../../conan_sources/conan/api/subapi/remove.py:docstring of
#: conan.api.subapi.remove.RemoveAPI.recipes:7
msgid "This method is not atomic wit respect to each of the given references"
msgstr ""

#: ../../../conan_sources/conan/api/subapi/remove.py:docstring of
#: conan.api.subapi.remove.RemoveAPI.recipes:9
msgid "List of recipe references to delete, must contain recipe revisions"
msgstr ""

#: ../../../conan_sources/conan/api/subapi/remove.py:docstring of
#: conan.api.subapi.remove.RemoveAPI.package:1
msgid "Removes the specified package reference."
msgstr ""

#: ../../../conan_sources/conan/api/subapi/remove.py:docstring of
#: conan.api.subapi.remove.RemoveAPI.package:6
msgid "Package reference to remove"
msgstr ""

#: ../../../conan_sources/conan/api/subapi/remove.py:docstring of
#: conan.api.subapi.remove.RemoveAPI.packages:1
msgid "Removes all the specified package references."
msgstr ""

#: ../../../conan_sources/conan/api/subapi/remove.py:docstring of
#: conan.api.subapi.remove.RemoveAPI.packages:7
msgid ""
"This method is not atomic when performed in the local cache with respect to "
"each of the given references, nor are remotes guaranteed to implement this "
"call atomically either."
msgstr ""

#: ../../../conan_sources/conan/api/subapi/remove.py:docstring of
#: conan.api.subapi.remove.RemoveAPI.packages:11
msgid "List of package references to delete, must contain package revisions"
msgstr ""
