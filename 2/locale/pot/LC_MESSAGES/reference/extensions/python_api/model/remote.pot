#: ../../../reference/extensions/python_api/model/remote.rst:2
msgid "Remote model"
msgstr ""

#: ../../../conan_sources/conan/api/model/remote.py:docstring of
#: conan.api.model.remote.Remote:1
msgid "The ``Remote`` class represents a remote registry of packages."
msgstr ""

#: ../../../conan_sources/conan/api/model/remote.py:docstring of
#: conan.api.model.remote.Remote:3
msgid ""
"A Remote object can be constructed to be passed as an argument to RemotesAPI "
"methods. When possible, it is better to use Remote objects returned by the "
"API, but for the ``RemotesAPI.add()`` method, for which a new constructed "
"object is necessary. It is recommended to use named arguments like "
"``Remote(..., verify_ssl=False)`` in the constructor."
msgstr ""

#: ../../../conan_sources/conan/api/model/remote.py:docstring of
#: conan.api.model.remote.Remote:0
msgid "Parameters"
msgstr ""

#: ../../../conan_sources/conan/api/model/remote.py:docstring of
#: conan.api.model.remote.Remote:9
msgid "The name of the remote."
msgstr ""

#: ../../../conan_sources/conan/api/model/remote.py:docstring of
#: conan.api.model.remote.Remote:10
msgid ""
"The URL of the remote repository (or local folder for \"local-recipes-"
"index\")."
msgstr ""

#: ../../../conan_sources/conan/api/model/remote.py:docstring of
#: conan.api.model.remote.Remote:11
msgid "Enable SSL Certificate validation."
msgstr ""

#: ../../../conan_sources/conan/api/model/remote.py:docstring of
#: conan.api.model.remote.Remote:12
msgid "Disable the remote repository."
msgstr ""

#: ../../../conan_sources/conan/api/model/remote.py:docstring of
#: conan.api.model.remote.Remote:13
msgid "List of patterns of allowed packages from this remote"
msgstr ""

#: ../../../conan_sources/conan/api/model/remote.py:docstring of
#: conan.api.model.remote.Remote:14
msgid "Type of the remote repository, use \"local-recipes-index\" or ``None``"
msgstr ""

#: ../../../conan_sources/conan/api/model/remote.py:docstring of
#: conan.api.model.remote.Remote:15
msgid "If True, binaries form this remote will be ignored and never used"
msgstr ""

#: ../../../conan_sources/conan/api/model/remote.py:docstring of
#: conan.api.model.remote.Remote.invalidate_cache:1
msgid ""
"If external operations might have modified the remote since it was "
"instantiated, this method can be called to invalidate the cache. Note that "
"this is done automatically when the remote is used in any operation by "
"Conan, such as uploading packages, so this method is not usually needed when "
"only interacting with the Conan API"
msgstr ""
