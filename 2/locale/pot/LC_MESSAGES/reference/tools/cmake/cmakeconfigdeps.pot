#: of
#: conan.tools.cmake.cmakeconfigdeps.cmakeconfigdeps.CMakeConfigDeps.set_property:1
msgid ""
"Using this method you can overwrite the :ref:`property<CMakeConfigDeps "
"Properties>` values set by the Conan recipes from the consumer."
msgstr ""

#: ../../../conan_sources/conan/tools/cmake/cmakeconfigdeps/cmakeconfigdeps.py:docstring
#: of
#: conan.tools.cmake.cmakeconfigdeps.cmakeconfigdeps.CMakeConfigDeps.set_property:4
