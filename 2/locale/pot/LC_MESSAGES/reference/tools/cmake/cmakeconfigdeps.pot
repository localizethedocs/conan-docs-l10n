"Value of the property. Use ``None`` to invalidate any value set by the "
"upstream recipe."
msgstr ""

#: ../../../conan_sources/conan/tools/cmake/cmakeconfigdeps/cmakeconfigdeps.py:docstring
#: of
#: conan.tools.cmake.cmakeconfigdeps.cmakeconfigdeps.CMakeConfigDeps.set_property:9
