msgstr ""

#: ../../../conan_sources/conan/tools/cmake/cmakeconfigdeps/cmakeconfigdeps.py:docstring
#: of
#: conan.tools.cmake.cmakeconfigdeps.cmakeconfigdeps.CMakeConfigDeps.set_property:7
