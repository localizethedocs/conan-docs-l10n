#: ../../../reference/tools/scm/version.rst:4
msgid "Version"
msgstr ""

#: ../../../reference/tools/scm/version.rst:6
msgid ""
"This is a helper class to work with versions, it splits the version string "
"based on dots and hyphens. It exposes all the version components as "
"properties and offers total ordering through compare operators."
msgstr ""

#: ../../../reference/tools/scm/version.rst:12
msgid ""
"This is the reference for ``Version``. For more detailed explanations and "
"usage, visit the section about :ref:`semantic versionining in the "
"tutorial<tutorial_versioning_semantic>`"
msgstr ""

#: ../../../reference/tools/scm/version.rst:16
msgid "Comparing versions"
msgstr ""

#: ../../../reference/tools/scm/version.rst:16
msgid ""
" compiler_lower_than_12 = Version(self.settings.compiler.version) < "
"\"12.0\"\n"
"\n"
" is_legacy = Version(self.version) < 2"
msgstr ""

#: ../../../conan_sources/conan/internal/model/version.py:docstring of
#: conan.internal.model.version.Version:1
msgid ""
"This is NOT an implementation of semver, as users may use any pattern in "
"their versions. It is just a helper to parse \".\" or \"-\" and compare "
"taking into account integers when possible"
msgstr ""

#: ../../../reference/tools/scm/version.rst:28
msgid "Attributes"
msgstr ""

#: ../../../reference/tools/scm/version.rst:30
msgid ""
"The ``Version`` class offers ways to access the different parts of the "
"version number:"
msgstr ""

#: ../../../reference/tools/scm/version.rst:33
msgid "main"
msgstr ""

#: ../../../reference/tools/scm/version.rst:35
msgid "Get all the main digits."
msgstr ""

#: ../../../reference/tools/scm/version.rst:37
msgid ""
"v = Version(\"1.2.3.4-alpha.3+b.1\")\n"
"assert [str(i) for i in v.main] == ['1', '2', '3', '4', '5']"
msgstr ""

#: ../../../reference/tools/scm/version.rst:43
msgid "major"
msgstr ""

#: ../../../reference/tools/scm/version.rst:45
msgid "Get the major digit."
msgstr ""

#: ../../../reference/tools/scm/version.rst:47
msgid ""
"v = Version(\"1.2.3.4-alpha.3+b.1\")\n"
"assert str(v.major) == \"1\""
msgstr ""

#: ../../../reference/tools/scm/version.rst:53
msgid "minor"
msgstr ""

#: ../../../reference/tools/scm/version.rst:55
msgid "Get the minor digit."
msgstr ""

#: ../../../reference/tools/scm/version.rst:57
msgid ""
"v = Version(\"1.2.3.4-alpha.3+b.1\")\n"
"assert str(v.minor) == \"2\""
msgstr ""

#: ../../../reference/tools/scm/version.rst:64
msgid "patch"
msgstr ""

#: ../../../reference/tools/scm/version.rst:66
msgid "Get the patch digit."
msgstr ""

#: ../../../reference/tools/scm/version.rst:68
msgid ""
"v = Version(\"1.2.3.4-alpha.3+b.1\")\n"
"assert str(v.patch) == \"3\""
msgstr ""

#: ../../../reference/tools/scm/version.rst:75
msgid "micro"
msgstr ""

#: ../../../reference/tools/scm/version.rst:77
msgid "Get the micro digit."
msgstr ""

#: ../../../reference/tools/scm/version.rst:79
msgid ""
"v = Version(\"1.2.3.4-alpha.3+b.1\")\n"
"assert str(v.micro) == \"4\""
msgstr ""

#: ../../../reference/tools/scm/version.rst:86
msgid "pre"
msgstr ""

#: ../../../reference/tools/scm/version.rst:88
msgid "Get the pre-release digit."
msgstr ""

#: ../../../reference/tools/scm/version.rst:90
msgid ""
"v = Version(\"1.2.3.4-alpha.3+b.1\")\n"
"assert str(v.pre) == \"alpha.3\""
msgstr ""

#: ../../../reference/tools/scm/version.rst:96
msgid "build"
msgstr ""

#: ../../../reference/tools/scm/version.rst:98
msgid "Get the build digit."
msgstr ""

#: ../../../reference/tools/scm/version.rst:100
msgid ""
"v = Version(\"1.2.3.4-alpha.3+b.1\")\n"
"assert str(v.build) == \"b.1\""
msgstr ""

#: ../../../reference/tools/scm/version.rst:107
msgid ""
"If any field in the Version contains letters, it will be treated "
"alphabetically, so the relative order of numbers within those field will not "
"be correct. Make sure to separate with dots the digits, like ``alpha.3`` and "
"``build.1`` instead of ``alpha3`` and ``build1`` for correct ordering."
msgstr ""

#: ../../../reference/tools/scm/version.rst:113
msgid "Methods"
msgstr ""

#: ../../../reference/tools/scm/version.rst:115
msgid "The ``Version`` class implements the following methods:"
msgstr ""

#: ../../../reference/tools/scm/version.rst:118
msgid "in_range"
msgstr ""

#: ../../../reference/tools/scm/version.rst:120
msgid "Check if the version is in the specified range."
msgstr ""

#: ../../../reference/tools/scm/version.rst:122
msgid ""
"assert Version(\"1.0\").in_range(\">=1.0 <2\")\n"
"assert not Version(\"1.0\").in_range(\">1.0 <2\")\n"
"\n"
"assert not Version(\"1.0-rc\").in_range(\">=1.0 <2.0\")\n"
"assert Version(\"1.0-rc\").in_range(\">=1.0 <2.0\", resolve_prerelease=True)"
msgstr ""
