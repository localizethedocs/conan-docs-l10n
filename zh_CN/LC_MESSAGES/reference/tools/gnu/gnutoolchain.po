#: conan.tools.gnu.gnutoolchain.GnuToolchain.yes_no:1
msgid ""
"Simple wrapper to return \"yes\" or \"no\" depending on whether option_name "
"is evaluated as True or False."
msgstr ""

#: ../../../conan_sources/conan/tools/gnu/gnutoolchain.py:docstring of
#: conan.tools.gnu.gnutoolchain.GnuToolchain.yes_no:4
msgid "option name."
msgstr ""

#: ../../../conan_sources/conan/tools/gnu/gnutoolchain.py:docstring of
#: conan.tools.gnu.gnutoolchain.GnuToolchain.yes_no:5
