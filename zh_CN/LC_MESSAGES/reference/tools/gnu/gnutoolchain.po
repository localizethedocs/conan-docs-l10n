#: ../../../reference/tools/gnu/gnutoolchain.rst:168
msgid "**defines**"
msgstr ""

#: ../../../reference/tools/gnu/gnutoolchain.rst:169
msgid "**cxxflags**"
msgstr ""

#: ../../../reference/tools/gnu/gnutoolchain.rst:170
msgid "**cflags**"
msgstr ""

#: ../../../reference/tools/gnu/gnutoolchain.rst:171
