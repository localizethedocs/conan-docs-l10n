#: ../../../conan_sources/conan/tools/gnu/gnutoolchain.py:docstring of
#: conan.tools.gnu.gnutoolchain.GnuToolchain:6
msgid ""
"This argument avoids collisions when you have multiple toolchain calls in "
"the same recipe. By setting this argument, the *conanbuild.conf* file used "
"to pass information to the build helper will be named as "
"*<namespace>_conanbuild.conf*. The default value is ``None`` meaning that "
"the name of the generated file is *conanbuild.conf*. This namespace must be "
"also set with the same value in the constructor of the Autotools build "
"helper so that it reads the information from the proper file."
msgstr ""

