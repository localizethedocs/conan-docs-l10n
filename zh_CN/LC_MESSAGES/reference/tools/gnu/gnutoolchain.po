#: ../../../reference/tools/gnu/gnutoolchain.rst:175
msgid ""
"from conan import ConanFile\n"
"from conan.tools.gnu import GnuToolchain\n"
"\n"
"class App(ConanFile):\n"
"    settings = \"os\", \"arch\", \"compiler\", \"build_type\"\n"
"\n"
"    def generate(self):\n"
"        tc = GnuToolchain(self)\n"
"        # Customize the flags\n"
"        tc.extra_cxxflags = [\"MyFlag\"]\n"
"        # Read the computed flags and use them (write custom files etc)\n"
"        tc.defines\n"
"        tc.cxxflags\n"
"        tc.cflags\n"
"        tc.ldflags"
msgstr ""

#: ../../../reference/tools/gnu/gnutoolchain.rst:194
msgid ""
"If you want to change the default values for ``configure_args``, adjust the "
"``cpp.package`` object at the ``layout()`` method:"
msgstr ""

#: ../../../reference/tools/gnu/gnutoolchain.rst:196
msgid ""
"def layout(self):\n"
"    ...\n"
"    # For bindir and sbindir takes the first value:\n"
"    self.cpp.package.bindirs = [\"mybin\"]\n"
"    # For libdir takes the first value:\n"
"    self.cpp.package.libdirs = [\"mylib\"]\n"
"    # For includedir and oldincludedir takes the first value:\n"
"    self.cpp.package.includedirs = [\"myinclude\"]\n"
"    # For datarootdir takes the first value:\n"
"    self.cpp.package.resdirs = [\"myres\"]"
msgstr ""

#: ../../../reference/tools/gnu/gnutoolchain.rst:210
msgid ""
"It is **not valid** to change the self.cpp_info  at the ``package_info()`` "
"method."
msgstr ""

#: ../../../reference/tools/gnu/gnutoolchain.rst:214
msgid "Managing the configure_args, make_args and autoreconf_args attributes"
msgstr ""

#: ../../../reference/tools/gnu/gnutoolchain.rst:216
msgid ""
"In ``GnuToolchain``, ``configure_args``, ``make_args`` and "
"``autoreconf_args`` are dict-like Python objects, so they can be managed "
"with the regular Python dictionary operations. This is the main difference "
"with the ``AutotoolsToolchain``, that uses lists of strings and some helper "
"methods to modify them. The rules are:"
msgstr ""

#: ../../../reference/tools/gnu/gnutoolchain.rst:220
msgid ""
"Key-value are the flags names and their values, e.g., ``{\"--enable-tools\": "
"\"no\"}`` will be translated as ``--enable-tools=no``."
msgstr ""

#: ../../../reference/tools/gnu/gnutoolchain.rst:221
msgid ""
"If that flag has no value, then the value must be ``None``, e.g., ``{\"--"
"disable-verbose\": None}`` will be translated as ``--disable-verbose``."
msgstr ""

#: ../../../reference/tools/gnu/gnutoolchain.rst:222
msgid ""
"Setting a key that already exists will update its value, and deleting a key "
"will remove the flag from the final result."
msgstr ""

#: ../../../reference/tools/gnu/gnutoolchain.rst:224
msgid "For instance:"
msgstr ""

#: ../../../reference/tools/gnu/gnutoolchain.rst:226
msgid ""
"from conan import ConanFile\n"
"from conan.tools.gnu import GnuToolchain\n"
"\n"
"class App(ConanFile):\n"
"    settings = \"os\", \"arch\", \"compiler\", \"build_type\"\n"
"\n"
"    def generate(self):\n"
"        tc = GnuToolchain(self)\n"
"        # add new flag '--new-super-flag'\n"
"        tc.configure_args[\"--new-super-flag\"] = None\n"
"        # update flag '--host=my-gnu-triplet'\n"
"        tc.configure_args[\"--host\"] = \"my-gnu-triplet\"\n"
"        # remove existing '--force' flag\n"
"        del tc.autoreconf_args[\"--force\"]\n"
"        tc.generate()"
msgstr ""

#: ../../../reference/tools/gnu/gnutoolchain.rst:244
msgid ""
"The ``GnuToolchain`` will listen to ``tools.gnu:extra_configure_args`` from "
"the :ref:`reference_config_files_global_conf` to extend the "
"``configure_args`` attribute."
msgstr ""

#: ../../../reference/tools/gnu/gnutoolchain.rst:247
msgid ""
"The ``yes_no()`` helper method returns ``\"yes\"`` or ``\"no\"`` depending "
"on the value of a recipe option, which is useful for the ``--enable-xxx=yes|"
"no`` arguments:"
msgstr ""

#: ../../../reference/tools/gnu/gnutoolchain.rst:250
msgid ""
"from conan import ConanFile\n"
"from conan.tools.gnu import GnuToolchain\n"
"\n"
"class App(ConanFile):\n"
"    settings = \"os\", \"arch\", \"compiler\", \"build_type\"\n"
"    options = {\"with_tools\": [True, False]}\n"
"    default_options = {\"with_tools\": True}\n"
"\n"
"    def generate(self):\n"
"        tc = GnuToolchain(self)\n"
"        # --enable-tools=yes or --enable-tools=no\n"
"        tc.configure_args[\"--enable-tools\"] = tc.yes_no(\"with_tools\")\n"
"        # Negated, --disable-tools=no or --disable-tools=yes\n"
"        tc.configure_args[\"--disable-tools\"] = tc.yes_no(\"with_tools\", "
"negated=True)\n"
"        tc.generate()"
msgstr ""

#: ../../../reference/tools/gnu/gnutoolchain.rst:270
msgid "Customizing the environment"
msgstr ""

#: ../../../reference/tools/gnu/gnutoolchain.rst:272
msgid ""
"If your ``Makefile`` or ``configure`` scripts need some other environment "
"variable rather than ``CPPFLAGS``, ``LDFLAGS``, ``CXXFLAGS`` or ``CFLAGS``, "
"you can define them in the ``extra_env`` attribute before calling the "
"``generate()`` method. It is "
"an :ref:`Environment<conan_tools_env_environment_model>` object, and the "
"values defined there have precedence over the ones that the toolchain "
"computes by default:"
msgstr ""

#: ../../../reference/tools/gnu/gnutoolchain.rst:277
msgid ""
"from conan import ConanFile\n"
"from conan.tools.gnu import GnuToolchain\n"
"\n"
"class App(ConanFile):\n"
"    settings = \"os\", \"arch\", \"compiler\", \"build_type\"\n"
"\n"
"    def generate(self):\n"
"        tc = GnuToolchain(self)\n"
"        tc.extra_env.define(\"FOO\", \"BAR\")\n"
"        # Prepend a compiler wrapper\n"
"        tc.extra_env.prepend(\"CC\", \"compile\")\n"
"        # Do not define RANLIB in the generated script\n"
"        tc.extra_env.unset(\"RANLIB\")\n"
"        tc.generate()"
msgstr ""

#: ../../../reference/tools/gnu/gnutoolchain.rst:294
msgid ""
"The ``GnuToolchain`` also sets ``CXXFLAGS``, ``CFLAGS``, ``LDFLAGS`` and "
"``CPPFLAGS`` reading variables from the ``[conf]`` section in the "
"profiles. :ref:`See the conf reference "
"below<conan_tools_gnu_gnutoolchain_conf>`."
msgstr ""

#: ../../../reference/tools/gnu/gnutoolchain.rst:299
msgid "Support for Universal Binaries in macOS"
msgstr ""

#: ../../../reference/tools/gnu/gnutoolchain.rst:301
msgid ""
"Starting in Conan 2.21.0, there's support for building universal binaries on "
"macOS using ``GnuToolchain``. To specify multiple architectures for a "
"universal binary in Conan, use the `|` separator when defining the "
"architecture in the settings. This approach enables passing a list of "
"architectures. For example, running:"
msgstr ""

#: ../../../reference/tools/gnu/gnutoolchain.rst:307
msgid "conan create . --name=mylibrary --version=1.0 -s=\"arch=armv8|x86_64\""
msgstr ""

#: ../../../reference/tools/gnu/gnutoolchain.rst:311
msgid ""
"will create a universal binary for *mylibrary* containing both ``armv8`` and "
"``x86_64`` architectures, by setting multiple ``-arch`` flags in the "
"generated toolchain script."
msgstr ""

#: ../../../reference/tools/gnu/gnutoolchain.rst:316
msgid ""
"Attempting to use universal architecture settings on non-Apple platforms "
"will result in an error."
msgstr ""

#: ../../../reference/tools/gnu/gnutoolchain.rst:319
msgid ""
"Be aware that this feature is primarily beneficial for building final "
"universal binaries for release purposes. The default Conan behavior of "
"managing one binary per architecture generally provides a more reliable and "
"trouble-free experience. Users should be cautious and not overly rely on "
"this feature for broader use cases."
msgstr ""

